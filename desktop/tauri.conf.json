{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pdit",
  "version": "0.1.0",
  "identifier": "app.pdit.desktop",
  "build": {
    "beforeBuildCommand": "./desktop/scripts/fetch-ocr.sh && cd crates/pdit-app && \"${CARGO_HOME:-$HOME/.cargo}/bin/dx\" build --release --platform web",
    "frontendDist": "../target/dx/pdit-app/release/web/public"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "category": "Productivity",
    "resources": {
      "resources/ocr/lib/": "ocr/lib/",
      "resources/ocr/tessdata/": "ocr/tessdata/",
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../licenses/": "licenses/"
    },
    "shortDescription": "A private PDF editor",
    "copyright": "AGPL-3.0-only",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
